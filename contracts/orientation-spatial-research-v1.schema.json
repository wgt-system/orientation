{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.wgt-system.org/orientation/spatial-research/1.0/schema.json",
  "title": "Orientation Spatial Research Bundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "researchedAt", "question", "sources", "candidates"],
  "properties": {
    "contract": {"const": "orientation.spatial-research-bundle"},
    "version": {"const": "1.0"},
    "researchedAt": {"type": "string", "format": "date-time"},
    "question": {"$ref": "#/$defs/question"},
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/source"}
    },
    "candidates": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "localRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionRef", "text", "area", "criteria"],
      "properties": {
        "questionRef": {"$ref": "#/$defs/localRef"},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "area": {"$ref": "#/$defs/area"},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/criterion"}
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "radiusMeters"],
      "properties": {
        "center": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label"],
          "properties": {
            "label": {"type": "string", "minLength": 1, "maxLength": 500},
            "coordinate": {"$ref": "#/$defs/coordinate"}
          }
        },
        "radiusMeters": {"type": "integer", "minimum": 1, "maximum": 500000}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionRef", "description", "evaluationMode"],
      "properties": {
        "criterionRef": {"$ref": "#/$defs/localRef"},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evaluationMode": {"enum": ["EVIDENCE_REQUIRED", "HEURISTIC"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "url", "retrievedAt"],
      "properties": {
        "sourceRef": {"$ref": "#/$defs/localRef"},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "retrievedAt": {"type": "string", "format": "date-time"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateRef", "displayName", "researchedLocation", "claims"],
      "properties": {
        "candidateRef": {"$ref": "#/$defs/localRef"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 500},
        "identity": {"$ref": "#/$defs/identity"},
        "researchedLocation": {"$ref": "#/$defs/researchedLocation"},
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/claim"}
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalUri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "externalIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "id"],
            "properties": {
              "provider": {"type": "string", "minLength": 1, "maxLength": 100},
              "id": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          }
        }
      },
      "anyOf": [
        {"required": ["canonicalUri"]},
        {"required": ["externalIds"]}
      ]
    },
    "researchedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "sourceRefs"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 500},
        "coordinate": {"$ref": "#/$defs/coordinate"},
        "sourceRefs": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/localRef"}
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionRef", "status", "basis", "sourceRefs"],
      "properties": {
        "criterionRef": {"$ref": "#/$defs/localRef"},
        "status": {"enum": ["MATCH", "NO_MATCH", "UNCERTAIN", "UNKNOWN"]},
        "basis": {"enum": ["DIRECT_EVIDENCE", "HEURISTIC"]},
        "observedValue": {
          "type": ["string", "number", "boolean", "null"]
        },
        "sourceRefs": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/localRef"}
        },
        "note": {"type": "string", "maxLength": 2000}
      }
    }
  }
}
